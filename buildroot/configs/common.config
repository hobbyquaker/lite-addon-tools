# lite-addon-tools: the part both architectures share. scripts/build.sh puts <arch>.config in
# front of it and runs `make defconfig` on the result.
#
# The toolchain: Bootlin's prebuilt musl "stable" toolchain, the version and sha256 Buildroot pins
# (toolchain/toolchain-external/toolchain-external-bootlin). Everything links statically.
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_STATIC_LIBS=y
BR2_OPTIMIZE_S=y
BR2_CCACHE=y
BR2_STRIP_strip=y
# no system, only the tools: no init, no shell, no BusyBox, no rootfs image
BR2_INIT_NONE=y
BR2_SYSTEM_BIN_SH_NONE=y
# BR2_PACKAGE_BUSYBOX is not set
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
# BR2_TARGET_ROOTFS_TAR is not set

# the libraries the tools need, without their extras
BR2_PACKAGE_NCURSES=y
BR2_PACKAGE_NCURSES_WCHAR=y
BR2_PACKAGE_NCURSES_ADDITIONAL_TERMINFO="t/tmux t/tmux-256color s/screen.xterm-256color r/rxvt r/rxvt-256color k/kitty a/alacritty f/foot w/wezterm s/st-256color"

# network
BR2_PACKAGE_SOCAT=y
BR2_PACKAGE_TCPDUMP=y
BR2_PACKAGE_NMAP=y
BR2_PACKAGE_NMAP_NMAP=y
# BR2_PACKAGE_NMAP_NCAT is not set
# BR2_PACKAGE_NMAP_NPING is not set
BR2_PACKAGE_MTR=y
BR2_PACKAGE_IPERF3=y
BR2_PACKAGE_LDNS=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_IFTOP=y
BR2_PACKAGE_ARP_SCAN=y
BR2_PACKAGE_ARP_SCAN_DATA=y

# system
BR2_PACKAGE_STRACE=y
BR2_PACKAGE_HTOP_STATIC=y
BR2_PACKAGE_IOTOP_C=y
BR2_PACKAGE_NANO=y
BR2_PACKAGE_TMUX=y
BR2_PACKAGE_NCDU=y
BR2_PACKAGE_PICOCOM=y
BR2_PACKAGE_LSOF=y
BR2_PACKAGE_PSMISC=y
BR2_PACKAGE_MMC_UTILS=y
BR2_PACKAGE_GDB=y
BR2_PACKAGE_GDB_SERVER=y
# BR2_PACKAGE_GDB_DEBUGGER is not set
